{
  "name": "project-workshop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspace @workshop/web && npm run build --workspace @workshop/server",
    "dev": "npm run dev --workspace @workshop/server",
    "test": "node --test apps/server/src/*.test.ts apps/web/app/*.test.ts"
  }
}
